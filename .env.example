# SentinelPay Environment Configuration Example

# Application Core
PROJECT_NAME="SentinelPay"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# Security & JWT Tokens
SECRET_KEY="sentinelpay_super_secure_enterprise_dev_secret_key_32bytes_min!"
POLICY_TOKEN_SECRET="sentinelpay_policy_execution_secret_key_9999!"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120
POLICY_TOKEN_EXPIRE_SECONDS=60

# Database Persistence
# For local dev without Postgres:
DATABASE_URL="sqlite+aiosqlite:///./sentinelpay.db"
# For Docker / PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://sentinel:sentinel_secure_password_999@localhost:5432/sentinelpay"

# Deterministic Policy Thresholds
POLICY_MAX_AUTO_REFUND_AMOUNT=10000.0   # Automated refund cap in INR (₹)
POLICY_MAX_DISPUTE_WINDOW_DAYS=60      # Regulatory dispute deadline
POLICY_MERCHANT_DISPUTE_RATIO_ALERT=0.015 # 1.5% dispute rate escalation trigger
POLICY_CUSTOMER_CHARGEBACK_LIMIT=3      # Max prior chargebacks before human review
AGENT_MAX_ITERATIONS=6                 # Max LangGraph agent execution cycles

# MCP Gateway
MCP_SERVER_HOST="127.0.0.1"
MCP_SERVER_PORT=8001

# Observability
ENABLE_OTEL_TRACING=false
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
